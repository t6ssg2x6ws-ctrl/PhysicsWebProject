[gd_scene format=3]

; ── Tom Riddle / old-quill system font ───────────────────────────────────────
[sub_resource type="SystemFont" id="SystemFont_riddle"]
font_names = PackedStringArray("Palatino Linotype", "Palatino", "Book Antiqua", "IM Fell English", "Georgia", "serif")
font_style = 1

; ─── Parchment panel StyleBox ─────────────────────────────────────────────────
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.878, 0.812, 0.671, 0.97)
border_width_left = 4
border_width_top = 4
border_width_right = 4
border_width_bottom = 4
border_color = Color(0.388, 0.263, 0.11, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
shadow_color = Color(0.1, 0.06, 0.02, 0.6)
shadow_size = 12

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_btn_normal"]
bg_color = Color(0.302, 0.192, 0.082, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.6, 0.42, 0.18, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_btn_hover"]
bg_color = Color(0.44, 0.28, 0.1, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.72, 0.56, 0.24, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_btn_pressed"]
bg_color = Color(0.2, 0.12, 0.04, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.5, 0.36, 0.14, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

; ─── Scene tree ───────────────────────────────────────────────────────────────
[node name="ParchmentPopup" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Dimmer" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.0, 0.0, 0.0, 0.52)
mouse_filter = 0

[node name="ParchmentPanel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -210.0
offset_top = -180.0
offset_right = 210.0
offset_bottom = 180.0
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="VBox" type="VBoxContainer" parent="ParchmentPanel"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="ScrollTitle" type="Label" parent="ParchmentPanel/VBox"]
layout_mode = 2
text = "⚯͛  Tom Riddle's Cipher  ⚯͛"
horizontal_alignment = 1
theme_override_fonts/font = SubResource("SystemFont_riddle")
theme_override_font_sizes/font_size = 22
theme_override_colors/font_color = Color(0.22, 0.12, 0.04, 1)

[node name="Divider" type="HSeparator" parent="ParchmentPanel/VBox"]
layout_mode = 2
theme_override_colors/separator_color = Color(0.388, 0.263, 0.11, 0.6)

[node name="Message" type="RichTextLabel" parent="ParchmentPanel/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(360, 100)
bbcode_enabled = true
text = "[center]…[/center]"
theme_override_fonts/normal_font = SubResource("SystemFont_riddle")
theme_override_font_sizes/normal_font_size = 20
theme_override_colors/default_color = Color(0.18, 0.1, 0.04, 1)
fit_content = true
scroll_active = false

[node name="TriesLabel" type="Label" parent="ParchmentPanel/VBox"]
layout_mode = 2
text = ""
horizontal_alignment = 1
theme_override_fonts/font = SubResource("SystemFont_riddle")
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0.52, 0.18, 0.08, 1)

[node name="TryAgainBtn" type="Button" parent="ParchmentPanel/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
text = "Try Again"
theme_override_fonts/font = SubResource("SystemFont_riddle")
theme_override_font_sizes/font_size = 20
theme_override_colors/font_color = Color(0.95, 0.88, 0.72, 1)
theme_override_colors/font_hover_color = Color(1, 1, 0.9, 1)
theme_override_styles/normal = SubResource("StyleBoxFlat_btn_normal")
theme_override_styles/hover = SubResource("StyleBoxFlat_btn_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_btn_pressed")
