theme_override_colors/font_color = Color(0.92, 0.87, 0.77, 1)
theme_override_font_sizes/font_size = 15
text = "The Serpent Arch door has sealed behind you, trapping you inside the Chamber of Secret Codes.

Complete the Hogwarts Trials step by step to reopen the door:
  1. Dumbledore's Triple Wand Trial (Gryffindor)
  2. Snape's Memory Trial (Slytherin)
  3. Flitwick's Steady Hand Test (Ravenclaw)
  4. Guess the Number (Hufflepuff)
  5. Visit the Sorting Hat Dais at the North Altar."
autowrap_mode = 3

